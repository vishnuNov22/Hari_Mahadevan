# Public base URL of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Optional: enquiry delivery via Resend (https://resend.com) ---
# Leave these empty and the contact form will NOT pretend to send.
# Instead it hands the visitor a pre-filled email to Hari (mailto fallback).
RESEND_API_KEY=
# Verified sender on your Resend domain, e.g. "Website <enquiries@your-domain.example>"
ENQUIRY_FROM_EMAIL=
# Inbox that receives enquiries
ENQUIRY_TO_EMAIL=harimahadevan2002@gmail.com
